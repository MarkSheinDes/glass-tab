{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Glass Tab",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "optional_permissions": [
    "bookmarks"
  ]
}
